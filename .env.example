# RepoRise Autoresearch Configuration
# Copy this file to .env.local and insert your keys.
# DO NOT commit .env.local to version control!

# Provider selection (llm, programmatic, llm-mock)
LLM_PROVIDER=gemini

# Base URL for OpenAI-compatible endpoint
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Target model
LLM_MODEL=gemini-2.5-pro

# Your API Key (required for LLM provider)
LLM_API_KEY=
